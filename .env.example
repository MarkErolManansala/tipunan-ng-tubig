# Environment variables read by lib/env.ts. Copy to .env.local and fill in.
# Only these names are used; anything else (POSTGRES_*, SUPABASE_JWT_SECRET,
# ...) comes from the Supabase dashboard's "Connect" dialog and is unused —
# this app talks to Supabase exclusively via supabase-js.

# ── Tubig API (optional — defaults shown) ────────────────────────────────────
# TUBIG_API_BASE_URL=https://tubig-api.rjhon.net
# TUBIG_API_RATE_LIMIT_PER_MINUTE=5

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — used for public reads, constrained by RLS.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key — sync writes, bypasses RLS. Never expose to client.
SUPABASE_SECRET_KEY=

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Bearer token for /api/cron/sync-dams. Undefined means the endpoint fails closed.
CRON_SECRET=
